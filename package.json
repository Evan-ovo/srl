{
  "name": "sillytavern-resource-library",
  "private": true,
  "version": "0.0.245",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "node scripts/Build.mjs",
    "android:sync": "pnpm build && cap sync android",
    "capacitor:copy:after": "node scripts/RunAndroidOptionalAppTrim.mjs",
    "android:open": "cap open android",
    "android:apk": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/Build-AndroidApk.ps1",
    "preview": "vite preview",
    "test": "vitest run --exclude \"server/**\" --exclude \"**/.codex-tmp/**\" --maxWorkers=4",
    "secret:scan": "node scripts/SecretScan.mjs",
    "secret:scan:history": "node scripts/SecretScan.mjs --history",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "audit:chat-reader": "node scripts/Run-ChatReaderAudit.mjs",
    "check:feature-contracts": "node scripts/Check-FeatureContracts.mjs",
    "audit:isolated": "node scripts/Run-IsolatedAudit.mjs",
    "check:candidate": "node scripts/Run-QualityGates.mjs candidate",
    "check:release": "node scripts/Run-QualityGates.mjs release",
    "check:assistant-knowledge": "node scripts/Check-AssistantKnowledge.mjs",
    "check:appearance-reference": "vitest run src/core/AppearanceReference.test.ts scripts/AppearanceReferenceCatalog.test.ts src/services/AppearanceReferenceService.test.ts --maxWorkers=2",
    "check:structure": "node scripts/Check-SourceStructure.mjs",
    "check:build-info": "node scripts/Check-BuildInfo.mjs",
    "audit:mobile": "node scripts/MobileAudit.mjs",
    "audit:mobile-workflows": "node scripts/MobileWorkflowAudit.mjs",
    "audit:mobile-features": "node scripts/MobileFeatureInteractionAudit.mjs",
    "audit:safe-area": "node scripts/SafeAreaUiAudit.mjs",
    "audit:image-generation-viewport": "node scripts/ImageGenerationViewportAudit.mjs",
    "audit:settings-viewport": "node scripts/SettingsViewportAudit.mjs",
    "audit:stitch-browser-regression": "node scripts/PresetStitcherBrowserRegression.mjs",
    "audit:frontend-workbench-reference": "node scripts/FrontendWorkshopReferenceAudit.mjs",
    "audit:frontend-workbench-components": "node scripts/FrontendWorkshopComponentInteractionAudit.mjs",
    "audit:frontend-workbench-direct-transform": "node scripts/FrontendWorkshopDirectTransformAudit.mjs",
    "audit:frontend-workbench-viewport": "node scripts/FrontendWorkshopViewportAudit.mjs",
    "audit:frontend-workbench-reparent": "node scripts/FrontendWorkshopReparentAudit.mjs",
    "audit:frontend-workbench-inspector": "node scripts/FrontendWorkshopConstraintAudit.mjs",
    "audit:render-parity": "node scripts/RenderParityAudit.mjs",
    "audit:render-compatibility": "node scripts/RenderCompatibilityAudit.mjs",
    "audit:preview-runtime-deep": "node scripts/PreviewRuntimeDeepAudit.mjs",
    "audit:stress-browser": "node scripts/BrowserStressAudit.mjs",
    "audit:pwa-offline": "node scripts/PwaOfflineSmoke.mjs",
    "audit:bundle-budget": "node scripts/BundleBudget.mjs",
    "audit:secrets": "node scripts/SecretScan.mjs",
    "test:flaky-candidates": "node scripts/RepeatFlakyCandidates.mjs",
    "check": "pnpm check:appearance-reference && pnpm check:structure && pnpm check:assistant-knowledge && pnpm check:build-info && pnpm format:check && pnpm lint && pnpm test && pnpm build",
    "public:web-build": "node scripts/Build-PublicWeb.mjs"
  },
  "dependencies": {
    "@adobe/css-tools": "4.4.4",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@noble/hashes": "^2.2.0",
    "@tailwindcss/browser": "4.3.3",
    "@vue/compiler-sfc": "3.5.40",
    "dexie": "^4.4.4",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.2",
    "esbuild-wasm": "0.28.1",
    "fflate": "^0.8.3",
    "html-to-image": "1.11.13",
    "jquery": "^3.7.1",
    "jquery-ui-dist": "1.13.3",
    "jquery-ui-touch-punch": "0.2.3",
    "jszip": "3.10.1",
    "lodash": "4.18.1",
    "pdfjs-dist": "6.4.299",
    "postcss": "8.5.19",
    "showdown": "2.1.0",
    "simple-apk-parser": "0.1.2",
    "toastr": "2.1.4",
    "vue": "^3.5.39",
    "vue-router": "5.2.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.2",
    "@types/showdown": "^2.0.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "playwright-core": "1.62.0",
    "prettier": "^3.9.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.5",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.113.0"
  }
}
